# Local development template. Contains NO real secrets.
# Copy to .env and run `php artisan key:generate`.
# Production values (credentials, keys, URLs) must come from the deployment secret store.

APP_NAME="Pati Parking"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON logs to stderr (see docs/architecture/observability.md).
LOG_CHANNEL=stack
LOG_STACK=structured
LOG_STRUCTURED_STREAM=php://stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the single source of truth. Hostnames match docker-compose services.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pati_parking
DB_USERNAME=pati
# Local docker password only. Never reuse outside local development.
DB_PASSWORD=pati_local_dev_only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=pati_parking_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=pati_parking_

# Inertia DevTools records request/page data to storage/. Off by default; enable locally only when needed.
INERTIA_DEVTOOLS_ENABLED=false

# Proxies allowed to set X-Forwarded-For (client IP in audit logs). Docker network range for local dev.
TRUSTED_PROXIES=172.16.0.0/12

# Mobile authentication (ADR-0005)
IDENTITY_ACCESS_TOKEN_TTL_MINUTES=60
IDENTITY_REFRESH_TOKEN_TTL_DAYS=30
IDENTITY_REFRESH_REUSE_GRACE_SECONDS=60

# Password for demo accounts created by `php artisan db:seed` (local only). Dev value, never reuse.
DEV_SEED_PASSWORD=Demo-Lokal-2026

# Connection timeouts (seconds): fail fast instead of hanging requests.
DB_CONNECT_TIMEOUT=3
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=2

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pati-parking.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Payment gateway (ADR-0006): "fake" for local development, "midtrans" for the sandbox.
# "fake" can never run in production. Never commit real keys; the sandbox key comes from the
# Midtrans sandbox dashboard (Settings > Access Keys).
PAYMENT_GATEWAY=fake
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_PRODUCTION_APPROVED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_QRIS_ACQUIRER=gopay

# Monitoring map tiles (master doc §31). Empty = points only. Use a tile service whose usage
# policy fits production traffic.
REPORTING_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
REPORTING_MAP_ATTRIBUTION="© OpenStreetMap contributors"
REPORTING_MAX_RANGE_DAYS=366
